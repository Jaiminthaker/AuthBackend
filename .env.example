PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/authbackend
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Auth API <no-reply@example.com>
SMTP_TEST_MODE=false

EMAIL_PROVIDER=smtp
MAILTRAP_API_TOKEN=TOKENs
MAILTRAP_FROM_EMAIL=hello@demomailtrap.co
MAILTRAP_FROM_NAME=Auth API
MAILTRAP_CATEGORY=Password Reset